# API
HTTP_ADDR=:8080
DATABASE_URL=file:./data/platform.db?cache=shared&_fk=1
DATA_ROOT=./data/workspaces
SESSION_SECRET=dev-session-secret-change-me-please
DATA_ENCRYPTION_KEY=dev-data-encryption-key-32b-min!!
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DEV_AUTH_ENABLED=true
COOKIE_SECURE=false

# Optional OIDC (disable DEV_AUTH_ENABLED in production)
# OIDC_ISSUER=https://keycloak.example/realms/cap
# OIDC_CLIENT_ID=coding-agent-platform
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback

# Runtime
CODING_TOOLS_IMAGE=coding-tools-mcp:local
DOCKER_NETWORK=agent-internal
PERMISSION_MODE=trusted
RUNTIME_IDLE_MINUTES=30
MCP_REQUEST_TIMEOUT_MS=120000
CHAT_MAX_ROUNDS=12
CHAT_MAX_TOOL_CALLS=32

# Default model (or configure in Admin UI)
DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Web
NEXT_PUBLIC_API_BASE=http://localhost:8080
